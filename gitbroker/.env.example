# Copy to .env (in this gitbroker/ folder) and fill in. .env is gitignored —
# never commit it.

# Per-repo secret shared with the native gitbroker service on your machine. Must
# match THIS project's entry in the broker's registry (~/.config/gitbroker/
# registry.json). The secret IS the capability — it maps to exactly one repo, so
# no GitHub token is ever needed inside the sandbox.
BROKER_SECRET=

# Optional — skip LAN discovery by pinning the broker location. Otherwise
# broker-publish.mjs probes for the host and caches the working URL in
# .broker-host (also in this folder).
# BROKER_URL=http://192.168.1.10:4747
# BROKER_PORT=4747
