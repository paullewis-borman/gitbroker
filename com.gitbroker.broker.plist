<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for gitbroker.

  IMPORTANT macOS notes (Launch Agents are NOT like your Terminal):
   1. PATH: launchd has a minimal PATH and won't find nvm/Homebrew `node` or
      `git`. So we call node by ABSOLUTE path and set PATH explicitly below.
      Find your node path:  readlink -f "$(which node)"
      Put it in ProgramArguments[0], and make sure its directory + git's
      directory are in the PATH string under EnvironmentVariables.
   2. Full Disk Access: the broker runs git inside ~/Documents/... which macOS
      protects under TCC. The agent will get "Operation not permitted" until you
      grant Full Disk Access to the node binary:
        System Settings -> Privacy & Security -> Full Disk Access -> + -> add node
   3. Logs go to ~/Library/Logs (always writable), NOT into the protected repo.

  Install / reload:
    cp com.gitbroker.broker.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gitbroker.broker.plist
  Reload after edits:
    launchctl bootout gui/$(id -u)/com.gitbroker.broker 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gitbroker.broker.plist
  Check:  launchctl print gui/$(id -u)/com.gitbroker.broker | head
          tail -f ~/Library/Logs/gitbroker.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gitbroker.broker</string>

    <!-- ProgramArguments[0] MUST be your absolute node path (readlink -f $(which node)). -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/Cellar/node/23.3.0/bin/node</string>
        <string>/Users/plb/Documents/NewRepo/gitbroker/broker.mjs</string>
    </array>

    <!-- Explicit PATH so the broker's `git` subprocess resolves. Add your node
         dir if it isn't already one of these (e.g. an nvm path). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Logs OUTSIDE the TCC-protected repo. -->
    <key>StandardOutPath</key>
    <string>/Users/plb/Library/Logs/gitbroker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/plb/Library/Logs/gitbroker.log</string>
</dict>
</plist>
